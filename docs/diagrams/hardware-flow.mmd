%% Hardware signal flow and wiring overview (docs/hardware/wiring.md).
flowchart LR
    MACHINE["Coffee machine<br/>green READY LED"] -. "optical coupling only" .-> PT

    subgraph sensor["Sensor circuit (emitter follower)"]
        direction TB
        V33["3V3"] --> PT["TEPT4400<br/>collector → emitter"]
        PT --> NODE(("GPIO34<br/>ADC1_CH6"))
        NODE --> R1["10 kΩ"] --> GND1["GND"]
    end

    NODE --> ESP["ESP32 DevKit V1"]

    ESP -- "GPIO25" --> DRV["NPN driver<br/>(optional)"] --> BUZZER["Active buzzer"]
    ESP -- "GPIO2" --> LED["Status LED<br/>(on-board)"]
    ESP -- "2.4 GHz Wi-Fi" --> ROUTER["Router → Home Assistant"]

    USB["USB 5 V"] --> ESP
    BATTERY["LiPo + charger<br/>(roadmap v0.4)"] -.-> ESP

    classDef ext fill:#f3f3f3,stroke:#8d8d8d,color:#1b1b1b;
    classDef warn fill:#fdecec,stroke:#c62828,color:#1b1b1b;
    class MACHINE warn;
    class ROUTER,USB,BATTERY ext;
